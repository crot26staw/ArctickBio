# Скопировать в .env (.env в git не попадает)
WP_PORT=8095
MAIL_PORT=8096
PMA_PORT=8097

DB_NAME=arctik
DB_USER=arctik
DB_PASSWORD=arctik
DB_ROOT_PASSWORD=root
DB_PREFIX=wp_

WP_URL=http://localhost:8095
WP_TITLE=АрктикБио
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@arctik.local

# ---------- Хостинг (Reg.ru), см. WORDPRESS.md → «Деплой» ----------
# Адрес сайта на хостинге (без слеша в конце) — им заменяется WP_URL в дампе базы
PROD_URL=https://arcticbiomarine.ru
# Пароль и почта админа (логин WP_ADMIN_USER) на хостинге — подставляются в дамп; пустой пароль — сгенерируется (scripts/out/admin-password.txt)
PROD_ADMIN_PASSWORD=
PROD_ADMIN_EMAIL=
# База MySQL на хостинге (создаётся в панели Reg.ru → «Базы данных»; хост на Reg.ru — localhost) — для wp-config.php прода
PROD_DB_NAME=
PROD_DB_USER=
PROD_DB_PASSWORD=
PROD_DB_HOST=localhost
# FTP: путь к папке сайта от корня FTP (папка с wp-config.php), без слешей по краям.
# Хост — имя сервера (server126.hosting.reg.ru), не IP: сертификат FTPS выписан на *.hosting.reg.ru
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
FTP_SITE_PATH=www/arcticbiomarine.ru
# ftps (FTP с TLS) или ftp
FTP_PROTOCOL=ftps
